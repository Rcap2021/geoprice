# GeoPrice Travel - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED - Anthropic API for chat
# ===========================================
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===========================================
# REQUIRED - Proxy Configuration (Exalive.ai)
# ===========================================
# Format depends on your Exalive proxy setup
# Common formats:
#   http://user:pass@proxy.exalive.ai:PORT
#   socks5://user:pass@proxy.exalive.ai:PORT

# Option 1: Single endpoint with geo targeting via URL params
PROXY_BASE_URL=http://proxy.exalive.ai:PORT
PROXY_USERNAME=your_username
PROXY_PASSWORD=your_password

# Option 2: If your proxy uses country-specific ports
# PROXY_BR=http://user:pass@proxy.exalive.ai:10001
# PROXY_IN=http://user:pass@proxy.exalive.ai:10002
# ... etc

# ===========================================
# OPTIONAL - Database (for production)
# ===========================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/geoprice
# REDIS_URL=redis://localhost:6379

# ===========================================
# OPTIONAL - Affiliate Configuration
# ===========================================
# AFFILIATE_NETWORK=cj  # or "awin"
# AFFILIATE_ID=your_affiliate_id

# ===========================================
# OPTIONAL - Scraping Configuration
# ===========================================
# MAX_CONCURRENT_SCRAPERS=4
# SCRAPE_TIMEOUT_MS=30000
# CACHE_TTL_HOURS=24
