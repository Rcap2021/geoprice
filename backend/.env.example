# GeoPrice Travel - Environment Configuration

# ============== LLM ==============
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============== Proxy Network ==============
# Exalive.ai proxy configuration
# Format depends on your proxy setup - adjust accordingly

# Option 1: Base URL with country suffix
PROXY_BASE_URL=http://proxy.exalive.ai:PORT
PROXY_USERNAME=your_username
PROXY_PASSWORD=your_password

# Option 2: Direct proxy URLs per country (alternative)
# PROXY_URL_BR=http://user:pass@br.proxy.exalive.ai:PORT
# PROXY_URL_IN=http://user:pass@in.proxy.exalive.ai:PORT
# ... etc

# ============== Database (Production) ==============
DATABASE_URL=postgresql://user:pass@localhost:5432/geoprice
REDIS_URL=redis://localhost:6379

# ============== Server ==============
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ============== Affiliate ==============
# Booking.com affiliate (via CJ or Awin)
AFFILIATE_NETWORK=cj
AFFILIATE_ID=your_affiliate_id

# ============== Scraper Settings ==============
MAX_CONCURRENT_SCRAPERS=4
SCRAPER_TIMEOUT_MS=30000
